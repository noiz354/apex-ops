# Apex Ops — environment template. NEVER commit real secrets (C21: prod shows last4 only).
# Tenant is fixed by canon: APX-NUSA-01

# --- Phase 1: database (PGlite, repo-local) ---------------------------------
# Data directory for the embedded Postgres (WASM). Default: .data/pg
# PGDATA_DIR=.data/pg

# --- Phase 1: auth / demo ----------------------------------------------------
# Seed password for all demo users (db/seed.ts). Change for any shared env.
# SEED_USER_PASSWORD=demo-pass-4821
# Base32 TOTP secret seeded for demo users (import into an authenticator app).
# SEED_TOTP_SECRET=JBSWY3DPEHPK3PXP
# Set to 0 to hide the dev MFA hint (login API stops returning devHint).
# The hint is already disabled automatically when NODE_ENV=production.
# DEMO_MFA_HINT=1

# --- Billing (Stripe) — GAP-06 ----------------------------------------------
# Webhook signing secret (Stripe Dashboard → Developers → Webhooks).
# Webhook route fails closed (503) when unset; checkout fails closed too.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Secret key for creating real Checkout Sessions (server-side only, never NEXT_PUBLIC).
# STRIPE_SECRET_KEY=sk_test_...
# Per-plan recurring Price IDs for checkout.
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# Demo mode (submission/offline): deterministic cs_demo_* fixture, zero
# Stripe network, zero secrets. NEVER enable in production.
# BILLING_DEMO_MODE=true

# --- Legacy (unused by the real backend; kept for reference) -----------------
# NEXT_PUBLIC_API_BASE=https://api.apexops.internal/api/v1
